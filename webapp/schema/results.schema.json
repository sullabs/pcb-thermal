{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcb-thermal/schema/results.schema.json",
  "title": "results.json: simulation runs",
  "description": "Written by the macros only (Run Thermal Study, Read Results, Run Flow). Oldest run first.",
  "type": "object",
  "required": ["schema", "schemaVersion", "savedBy", "savedAt", "runs"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pcb-thermal/results" },
    "schemaVersion": { "const": 1 },
    "savedBy": { "type": "string" },
    "savedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "minMax": {
      "type": "object",
      "required": ["maxC", "minC"],
      "additionalProperties": false,
      "properties": {
        "maxC": { "$ref": "common.schema.json#/$defs/degC" },
        "minC": { "$ref": "common.schema.json#/$defs/degC" }
      }
    },
    "run": {
      "type": "object",
      "required": ["name", "date", "studyType", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Run name, e.g. PT_20261014_1528. Thermal runs start PT_, Flow runs FL_." },
        "date": { "$ref": "common.schema.json#/$defs/dateTime" },
        "studyType": { "$ref": "common.schema.json#/$defs/studyType" },
        "study": { "type": "string", "description": "Study name in SolidWorks." },
        "status": { "enum": ["set up", "solved", "read", "failed"], "description": "set up = study made, not solved yet; read = temperatures read back." },
        "assembly": { "type": "string" },
        "spreaderFiles": { "type": "array", "items": { "type": "string" } },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "globalMm": { "$ref": "common.schema.json#/$defs/mmPos" },
            "fineMm": { "$ref": "common.schema.json#/$defs/mmPos" },
            "nodes": { "type": "integer", "minimum": 0 },
            "elements": { "type": "integer", "minimum": 0 }
          }
        },
        "inputs": {
          "type": "object",
          "description": "Copy of project.json forSolidWorks and simSetup at run time, so an old run always shows what it was made with.",
          "additionalProperties": false,
          "properties": {
            "forSolidWorks": { "type": "object" },
            "simSetup": { "type": "object" },
            "summary": {
              "type": "object",
              "description": "Short form kept by old workbooks that did not store the full copy.",
              "additionalProperties": false,
              "properties": {
                "hSpreaderTop": { "type": "number" },
                "hPcbTop": { "type": "number" },
                "timModes": { "type": "string" }
              }
            }
          }
        },
        "spreader": { "$ref": "#/$defs/minMax" },
        "pcb": { "$ref": "#/$defs/minMax" },
        "energyBalancePct": { "type": "number", "description": "|heat in - heat out| / larger of the two, %. Near 0 means the study converged." },
        "parts": {
          "type": "object",
          "description": "Temperature per RefDes.",
          "additionalProperties": {
            "type": "object",
            "required": ["peakC"],
            "additionalProperties": false,
            "properties": {
              "peakC": { "$ref": "common.schema.json#/$defs/degC" },
              "avgC": { "$ref": "common.schema.json#/$defs/degC" }
            }
          }
        },
        "plotFile": { "type": "string", "description": "Picture of the temperature plot." },
        "report": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
