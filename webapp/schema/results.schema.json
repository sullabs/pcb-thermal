{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcb-thermal/schema/results.schema.json",
  "title": "results.json: simulation runs",
  "description": "Written by the macros only (Run Thermal Study, Read Results, Run Flow). Oldest run first.",
  "type": "object",
  "required": ["schema", "schemaVersion", "savedBy", "savedAt", "runs"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pcb-thermal/results" },
    "schemaVersion": { "const": 1 },
    "savedBy": { "type": "string" },
    "savedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "minMax": {
      "type": "object",
      "required": ["maxC", "minC"],
      "additionalProperties": false,
      "properties": {
        "maxC": { "$ref": "common.schema.json#/$defs/degC" },
        "minC": { "$ref": "common.schema.json#/$defs/degC" }
      }
    },
    "run": {
      "type": "object",
      "required": ["name", "date", "studyType", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Run name, e.g. PT_20261014_1528. Thermal runs start PT_, Flow runs FL_." },
        "date": { "$ref": "common.schema.json#/$defs/dateTime" },
        "studyType": { "$ref": "common.schema.json#/$defs/studyType" },
        "study": { "type": "string", "description": "Study name in SolidWorks." },
        "status": { "enum": ["set up", "solved", "read", "failed"], "description": "set up = study made, not solved yet; read = temperatures read back." },
        "assembly": { "type": "string" },
        "spreaderFiles": { "type": "array", "items": { "type": "string" } },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "globalMm": { "$ref": "common.schema.json#/$defs/mmPos" },
            "fineMm": { "$ref": "common.schema.json#/$defs/mmPos" },
            "nodes": { "type": "integer", "minimum": 0 },
            "elements": { "type": "integer", "minimum": 0 },
            "level": { "type": "integer", "minimum": 1, "maximum": 7, "description": "Flow: global mesh level of the solve." },
            "localMesh": { "type": "boolean", "description": "Flow: local mesh on the parts with heat, TIMs and spreader." }
          }
        },
        "meshCheck": {
          "type": "object",
          "description": "Flow: this run is one of the two solves of a mesh check (same inputs, levels N and N+1).",
          "required": ["pairWith"],
          "additionalProperties": false,
          "properties": {
            "pairWith": { "type": "string", "description": "Name of the other run of the pair." },
            "level": { "type": "integer", "minimum": 1, "maximum": 7 }
          }
        },
        "inputs": {
          "type": "object",
          "description": "Copy of project.json forSolidWorks and simSetup at run time, so an old run always shows what it was made with.",
          "additionalProperties": false,
          "properties": {
            "forSolidWorks": { "type": "object" },
            "simSetup": { "type": "object" },
            "summary": {
              "type": "object",
              "description": "Short form kept by old workbooks that did not store the full copy.",
              "additionalProperties": false,
              "properties": {
                "hSpreaderTop": { "type": "number" },
                "hPcbTop": { "type": "number" },
                "timModes": { "type": "string" }
              }
            }
          }
        },
        "spreader": { "$ref": "#/$defs/minMax" },
        "pcb": { "$ref": "#/$defs/minMax" },
        "energyBalancePct": { "type": "number", "description": "|heat in - heat out| / larger of the two, %. Near 0 means the study converged. Flow: |heat applied - (Serv Heatf + Radiation Energy Delta)| / heat applied." },
        "heatRequestedW": { "type": "number", "minimum": 0, "description": "Flow: heat the page asked for, sum of forSolidWorks.heat (W)." },
        "heatAppliedW": { "type": "number", "minimum": 0, "description": "Flow: heat on the sources the solver meshed (W). Less than heatRequestedW when a source was unresolved." },
        "solver": {
          "type": "object",
          "description": "Flow: state of the solve, from <n>.info.json of the Flow project folder.",
          "additionalProperties": false,
          "properties": {
            "finished": { "type": "boolean" },
            "iterations": { "type": "integer", "minimum": 0 },
            "travels": { "type": "number", "minimum": 0 },
            "cellsTotal": { "type": "integer", "minimum": 0 },
            "cellsSolid": { "type": "integer", "minimum": 0 },
            "cellsFluid": { "type": "integer", "minimum": 0 },
            "projectDir": { "type": "string" }
          }
        },
        "goalsHealth": {
          "type": "object",
          "description": "Flow: convergence per goal name. delta and criteria in K (= C for a difference).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "progressPct": { "type": "number" },
              "deltaC": { "type": "number" },
              "criteriaC": { "type": "number" }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" }, "description": "Flow: lines of calculation_warnings.txt." },
        "unresolved": { "type": "array", "items": { "type": "string" }, "description": "Flow: RefDes whose source or goal the solver could not resolve (not meshed). Their goals are not stored." },
        "parts": {
          "type": "object",
          "description": "Temperature per RefDes.",
          "additionalProperties": {
            "type": "object",
            "required": ["peakC"],
            "additionalProperties": false,
            "properties": {
              "peakC": { "$ref": "common.schema.json#/$defs/degC" },
              "avgC": { "$ref": "common.schema.json#/$defs/degC" }
            }
          }
        },
        "plotFile": { "type": "string", "description": "Picture of the temperature plot." },
        "report": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
