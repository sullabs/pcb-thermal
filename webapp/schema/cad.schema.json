{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcb-thermal/schema/cad.schema.json",
  "title": "cad.json: what SolidWorks knows",
  "description": "Written by the macros only (Import STEP, Build Board, Build Spreader, Sync CAD). The page reads it.",
  "type": "object",
  "required": ["schema", "schemaVersion", "savedBy", "savedAt"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pcb-thermal/cad" },
    "schemaVersion": { "const": 1 },
    "savedBy": { "type": "string" },
    "savedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "import": { "$ref": "#/$defs/import" },
    "importPrevious": { "$ref": "#/$defs/import" },
    "build": { "$ref": "#/$defs/build" },
    "spreaderBuild": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "$ref": "#/$defs/plateBuild" },
        "bottom": { "$ref": "#/$defs/plateBuild" }
      }
    },
    "asBuilt": { "$ref": "#/$defs/asBuilt" },
    "changes": {
      "type": "array",
      "description": "Newest first. The user checks each one in the page (project.json checks).",
      "items": { "$ref": "#/$defs/change" }
    }
  },

  "$defs": {
    "importedBody": {
      "type": "object",
      "required": ["key", "name", "box", "side"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "common.schema.json#/$defs/bodyKey" },
        "name": { "type": "string", "description": "Body name from the model (component path)." },
        "box": { "$ref": "common.schema.json#/$defs/box" },
        "side": { "$ref": "common.schema.json#/$defs/side" },
        "rotDeg": { "type": "number", "description": "Turn in the board plane (degrees). 0 = edges along X and Y." },
        "ownL": { "$ref": "common.schema.json#/$defs/mmPos", "description": "Length along the body's own edge, when turned." },
        "ownW": { "$ref": "common.schema.json#/$defs/mmPos" }
      }
    },
    "import": {
      "type": "object",
      "required": ["model", "date", "frame", "pcb", "bodies"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "description": "Model name or path that was imported." },
        "date": { "$ref": "common.schema.json#/$defs/dateTime" },
        "frame": { "type": "string", "description": "How board axes map to model axes, in words." },
        "settingsUsed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pcbNameContains": { "type": "string" },
            "minSizeMm": { "type": "number", "minimum": 0 },
            "topLevelOnly": { "type": "boolean" }
          }
        },
        "pcb": {
          "type": "object",
          "required": ["name", "box"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "box": { "$ref": "common.schema.json#/$defs/box" }
          }
        },
        "bodies": { "type": "array", "items": { "$ref": "#/$defs/importedBody" } },
        "messages": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/message" } }
      }
    },
    "build": {
      "type": "object",
      "required": ["assembly", "date", "mode", "bodies"],
      "additionalProperties": false,
      "properties": {
        "assembly": { "type": "string", "description": "Full path of the thermal assembly." },
        "date": { "$ref": "common.schema.json#/$defs/dateTime" },
        "mode": { "enum": ["create", "update"] },
        "inputsHash": { "type": "string", "description": "Hash of forSolidWorks.bodies and pcb at build time. The page compares it to spot an out-of-date model." },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wanted": { "type": "integer", "minimum": 0 },
            "added": { "type": "integer", "minimum": 0 },
            "moved": { "type": "integer", "minimum": 0 },
            "resized": { "type": "integer", "minimum": 0 },
            "suppressed": { "type": "integer", "minimum": 0 },
            "broughtBack": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "rotated": { "type": "integer", "minimum": 0 }
          }
        },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "common.schema.json#/$defs/bodyKey" },
              "name": { "type": "string" },
              "status": { "enum": ["built", "failed", "skipped", "suppressed"] },
              "reason": { "type": "string", "description": "Why it failed or was skipped." },
              "cutAtBoardMm": { "type": "number", "minimum": 0, "description": "How far the STEP body went into the PCB. The box starts at the board surface instead." },
              "file": { "type": "string" }
            }
          }
        },
        "overlaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["a", "b", "size"],
            "additionalProperties": false,
            "properties": {
              "a": { "type": "string", "description": "Key, or name when the key is not known." },
              "b": { "type": "string" },
              "size": {
                "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 3, "maxItems": 3,
                "description": "Overlap along X, Y, Z (mm)."
              }
            }
          }
        },
        "report": { "type": "string", "description": "Path of the text report." }
      }
    },
    "plateBuild": {
      "type": "object",
      "required": ["date", "file"],
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "common.schema.json#/$defs/dateTime" },
        "file": { "type": "string" },
        "pedestals": { "type": "integer", "minimum": 0 },
        "tims": { "type": "array", "items": { "type": "string" }, "description": "TIM part files built." },
        "cuts": { "type": "integer", "minimum": 0 },
        "failures": { "type": "array", "items": { "type": "string" } },
        "report": { "type": "string" }
      }
    },
    "asBuilt": {
      "type": "object",
      "required": ["date"],
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "common.schema.json#/$defs/dateTime" },
        "plates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "$ref": "#/$defs/plateAsBuilt" },
            "bottom": { "$ref": "#/$defs/plateAsBuilt" }
          }
        },
        "bodies": {
          "type": "array",
          "description": "Boxes read back from the assembly, for bodies that differ from what was asked.",
          "items": {
            "type": "object",
            "required": ["key", "box"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "common.schema.json#/$defs/bodyKey" },
              "box": { "$ref": "common.schema.json#/$defs/box" }
            }
          }
        },
        "failedChecks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "plateAsBuilt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outlineAreaMm2": { "type": "number", "minimum": 0 },
        "topAreaMm2": { "type": "number", "minimum": 0 },
        "exposedAreaMm2": { "type": "number", "minimum": 0, "description": "All faces not touching a part." },
        "volumeMm3": { "type": "number", "minimum": 0 },
        "massG": { "type": "number", "minimum": 0 },
        "thicknessMm": { "type": "number", "minimum": 0 },
        "holes": { "type": "integer", "minimum": 0 },
        "chips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["refDes"],
            "additionalProperties": false,
            "properties": {
              "refDes": { "$ref": "common.schema.json#/$defs/refDes" },
              "pedestalMm": { "type": "number", "minimum": 0 },
              "timTMm": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "change": {
      "type": "object",
      "required": ["id", "date", "macro", "change"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}-[0-9]+$", "description": "yyyymmddThhmmss-n. Unique; the page stores the user's tick under it." },
        "date": { "$ref": "common.schema.json#/$defs/dateTime" },
        "macro": { "type": "string" },
        "key": { "type": "string" },
        "name": { "type": "string" },
        "refDes": { "$ref": "common.schema.json#/$defs/refDes" },
        "change": { "type": "string", "description": "What happened, e.g. 'moved', 'new body', 'check failed'." },
        "field": { "type": "string" },
        "old": { "type": ["string", "number"] },
        "new": { "type": ["string", "number"] },
        "delta": { "type": "number" }
      }
    }
  }
}
