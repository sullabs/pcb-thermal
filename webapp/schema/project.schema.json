{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcb-thermal/schema/project.schema.json",
  "title": "project.json: everything the user decides",
  "description": "Written by the page only. The macros read it. One file per board, in the board's project folder.",
  "type": "object",
  "required": ["schema", "schemaVersion", "savedBy", "savedAt", "board", "parts", "bodies", "pcbStack", "settings"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pcb-thermal/project" },
    "schemaVersion": { "const": 1 },
    "savedBy": { "type": "string" },
    "savedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "importedFrom": {
      "type": "object",
      "description": "Set when the project was made from an old workbook.",
      "required": ["file", "date"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "date": { "$ref": "common.schema.json#/$defs/dateTime" },
        "notes": { "type": "array", "items": { "type": "string" }, "description": "What the conversion changed or could not carry over." }
      }
    },

    "board": {
      "type": "object",
      "required": ["name", "ambientC"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Board name, used in reports and as the default file prefix." },
        "stepFile": { "type": "string", "description": "STEP file name, relative to the project folder." },
        "ambientC": { "$ref": "common.schema.json#/$defs/degC", "description": "Air temperature around the board, inside its enclosure (C)." },
        "measuredInputPowerW": { "$ref": "common.schema.json#/$defs/watt", "description": "Board input power measured at the supply (W). Optional: checks the sum of all part Pd." },
        "notes": { "type": "string", "description": "Enclosure, airflow, load case and other assumptions." }
      }
    },

    "parts": {
      "type": "array",
      "description": "One record per RefDes. A part can have several loads (a PMIC with four bucks).",
      "items": { "$ref": "#/$defs/part" }
    },

    "bodies": {
      "type": "object",
      "description": "The user's choices per body, by body key. Imported bodies get their size from cad.json; a body the user adds by hand (key m_...) carries its own box.",
      "propertyNames": { "$ref": "common.schema.json#/$defs/bodyKey" },
      "additionalProperties": { "$ref": "#/$defs/bodyChoice" }
    },

    "pcbOverride": {
      "$ref": "common.schema.json#/$defs/partialBox",
      "description": "Replaces the imported PCB size. Only l, w and h are used."
    },

    "pcbStack": {
      "type": "object",
      "description": "Copper and dielectric layers. The page turns them into one in-plane and one through-plane k for the PCB.",
      "required": ["copperLayers", "copperThicknessMm", "copperCoverage", "copperK", "dielectricK"],
      "additionalProperties": false,
      "properties": {
        "copperLayers": { "type": "integer", "minimum": 1, "maximum": 64 },
        "copperThicknessMm": { "$ref": "common.schema.json#/$defs/mmPos", "description": "Thickness of one copper layer (mm). The field accepts oz and um." },
        "copperCoverage": { "$ref": "common.schema.json#/$defs/fraction", "description": "Average share of each layer that is copper (0 to 1)." },
        "copperK": { "$ref": "common.schema.json#/$defs/kWmK" },
        "dielectricK": { "$ref": "common.schema.json#/$defs/kWmK" }
      }
    },

    "spreader": {
      "type": "object",
      "description": "Optional metal plates above (top) and below (bottom) the board.",
      "additionalProperties": false,
      "properties": {
        "top": { "$ref": "#/$defs/plate" },
        "bottom": { "$ref": "#/$defs/plate" }
      }
    },

    "handCheck": {
      "type": "object",
      "description": "Inputs used only by the hand calculations (bare board network and thermal solution).",
      "additionalProperties": false,
      "properties": {
        "surfaceRiseK": { "type": "number", "exclusiveMinimum": 0, "description": "Surface temperature rise assumed when turning radiation into an h (K)." },
        "compareRun": { "type": "string", "description": "Run name to compare the bare board network with. Blank = the newest run." },
        "solutionTop": { "$ref": "#/$defs/solution" },
        "solutionBottom": { "$ref": "#/$defs/solution" }
      }
    },

    "simSetup": {
      "type": "object",
      "required": ["studyType", "meshGlobalMm", "meshFineMm", "includePartsWithoutHeat", "kPartsWithoutHeat", "surfaces", "contacts"],
      "additionalProperties": false,
      "properties": {
        "studyType": { "$ref": "common.schema.json#/$defs/studyType" },
        "meshGlobalMm": { "$ref": "common.schema.json#/$defs/mmPos" },
        "meshFineMm": { "$ref": "common.schema.json#/$defs/mmPos", "description": "Mesh size on chips and TIMs (mm)." },
        "includePartsWithoutHeat": { "type": "boolean", "description": "No = parts without heat are left out of the study." },
        "kPartsWithoutHeat": { "$ref": "common.schema.json#/$defs/kWmK" },
        "surfaces": {
          "type": "object",
          "required": ["spreaderTop", "spreaderOther", "pcbTop", "pcbBottom", "parts"],
          "additionalProperties": false,
          "properties": {
            "spreaderTop": { "$ref": "common.schema.json#/$defs/surface" },
            "spreaderOther": { "$ref": "common.schema.json#/$defs/surface" },
            "pcbTop": { "$ref": "common.schema.json#/$defs/surface" },
            "pcbBottom": { "$ref": "common.schema.json#/$defs/surface" },
            "parts": { "$ref": "common.schema.json#/$defs/surface" }
          }
        },
        "contacts": {
          "type": "object",
          "description": "Contact resistance per interface, K m2/W. 0 = bonded.",
          "required": ["partToPcb", "chipToTim", "timToSpreader"],
          "additionalProperties": false,
          "properties": {
            "partToPcb": { "type": "number", "minimum": 0 },
            "chipToTim": { "type": "number", "minimum": 0 },
            "timToSpreader": { "type": "number", "minimum": 0 }
          }
        },
        "layerFrac": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.45, "description": "Two-resistor chips: thickness of the top and bottom layer as a share of the chip height. Blank = 0.1." },
        "kCore": { "$ref": "common.schema.json#/$defs/kWmK", "description": "Two-resistor chips: k of the junction core between the two layers. Blank = 100." },
        "flow": {
          "type": "object",
          "description": "Flow Simulation settings (tab 8, study type Flow). Blank values take the defaults of webapp/src/calc/flow.js.",
          "additionalProperties": false,
          "properties": {
            "meshLevel": { "type": "integer", "minimum": 1, "maximum": 7, "description": "Global mesh level. Blank = 4." },
            "localMesh": { "type": "boolean", "description": "A local mesh on every part with heat, the TIMs and the spreader. Blank = yes." },
            "solidRefine": { "type": "integer", "minimum": 0, "maximum": 9, "description": "Refinement of solid and solid/fluid boundary cells in the local mesh. Blank = 3." },
            "meshCheck": { "type": "boolean", "description": "Solve twice, at meshLevel and one level finer, and compare. Blank = no." },
            "meshCheckLimitC": { "type": "number", "exclusiveMinimum": 0, "description": "A mesh check is OK when every chip moved less than this (C). Blank = 1." },
            "minTravels": { "type": "number", "minimum": 1, "maximum": 20, "description": "The solve stops only after this many travels and with the goals converged. Blank = 2." },
            "goalCriteriaC": { "type": "number", "exclusiveMinimum": 0, "description": "A goal whose last change is above this (C) is flagged as not converged on tab 9. Blank = 0.2." },
            "environment": {
              "type": "object",
              "description": "Where the board sits (F6). Blank = flat, parts up, sea level, still air.",
              "additionalProperties": false,
              "properties": {
                "orientation": { "enum": ["flat, parts up", "flat, parts down", "vertical, long side up", "vertical, short side up"] },
                "pressureKPa": { "type": "number", "exclusiveMinimum": 0, "description": "Ambient pressure. Blank = from altitudeM, else 101.325." },
                "altitudeM": { "type": "number", "minimum": -500, "maximum": 10000, "description": "Used for the pressure when pressureKPa is blank." },
                "airSpeedMs": { "type": "number", "minimum": 0, "description": "Forced air speed. 0 or blank = natural convection." },
                "airDirection": { "enum": ["+X", "-X", "+Y", "-Y", "+Z"], "description": "Direction the air blows (board axes). Blank = +X." }
              }
            }
          }
        },
        "chips": {
          "type": "array",
          "description": "Chips modelled with a calibrated k. Others get kPartsWithoutHeat.",
          "items": {
            "type": "object",
            "required": ["refDes", "model"],
            "additionalProperties": false,
            "properties": {
              "refDes": { "$ref": "common.schema.json#/$defs/refDes" },
              "model": { "$ref": "common.schema.json#/$defs/chipModel" },
              "kxy": { "$ref": "common.schema.json#/$defs/kWmK", "description": "In-plane k of the chip block. Blank = same as k z." }
            }
          }
        }
      }
    },

    "settings": {
      "type": "object",
      "required": ["tolPosMm", "tolSizeMm", "import", "flagLimits"],
      "additionalProperties": false,
      "properties": {
        "partTemplate": { "type": "string", "description": "Full path of the .prtdot. Blank = SolidWorks default." },
        "asmTemplate": { "type": "string", "description": "Full path of the .asmdot. Blank = SolidWorks default." },
        "outputFolder": { "type": "string", "description": "Blank = CAD folder inside the project folder." },
        "filePrefix": { "type": "string", "description": "Blank = board name + _." },
        "asmName": { "type": "string", "description": "Blank = <prefix>Thermal.sldasm." },
        "tolPosMm": { "type": "number", "minimum": 0, "description": "Smaller moves are not reported as changes." },
        "tolSizeMm": { "type": "number", "minimum": 0, "description": "Smaller size changes are not reported." },
        "import": {
          "type": "object",
          "required": ["pcbNameContains", "minSizeMm", "topLevelOnly"],
          "additionalProperties": false,
          "properties": {
            "pcbNameContains": { "type": "string", "minLength": 1, "description": "Import STEP takes the body whose name contains this text as the PCB." },
            "minSizeMm": { "type": "number", "minimum": 0, "description": "Skip bodies with L and W both under this (mm)." },
            "topLevelOnly": { "type": "boolean", "description": "Yes = one body per top-level component of the STEP. No = every solid body." }
          }
        },
        "flagLimits": {
          "type": "object",
          "required": ["critical", "watch"],
          "additionalProperties": false,
          "properties": {
            "critical": { "$ref": "#/$defs/flagLimit" },
            "watch": { "$ref": "#/$defs/flagLimit" }
          }
        }
      }
    },

    "forSolidWorks": { "$ref": "#/$defs/forSolidWorks" },

    "checks": {
      "type": "object",
      "description": "Change records the user has checked, by change id (cad.json changes[]), and page checks the user has accepted (heat-no-body/<RefDes>: a part with heat and no body, on purpose).",
      "additionalProperties": {
        "type": "object",
        "required": ["at"],
        "additionalProperties": false,
        "properties": {
          "at": { "$ref": "common.schema.json#/$defs/dateTime" },
          "note": { "type": "string" }
        }
      }
    }
  },

  "$defs": {
    "partClass": {
      "enum": ["Processor / SoC", "Memory", "LDO / linear reg", "Switching regulator", "PMIC", "Ethernet PHY",
               "USB / interface IC", "Power inductor", "Sense resistor", "MOSFET / driver", "Connector", "Other",
               "RF / wireless module"],
      "description": "Kind of part. Sets the default power method."
    },
    "powerMethod": {
      "enum": ["LDO / linear reg", "Switching regulator", "Digital load (V x I)", "Resistive (I squared R)", "Manual entry"],
      "description": "How Pd is worked out for a load."
    },
    "part": {
      "type": "object",
      "required": ["id", "refDes", "loads"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]+$", "description": "Internal id. Never changes, even if the RefDes does." },
        "refDes": { "$ref": "common.schema.json#/$defs/refDes" },
        "partNumber": { "type": "string" },
        "class": { "$ref": "#/$defs/partClass" },
        "package": { "type": "string" },
        "tjMaxC": { "$ref": "common.schema.json#/$defs/degC", "description": "Highest junction temperature allowed by the datasheet." },
        "rjaCW": { "$ref": "common.schema.json#/$defs/cPerW", "description": "Junction to ambient, JEDEC board. For ranking only." },
        "rjcCW": { "$ref": "common.schema.json#/$defs/cPerW", "description": "Junction to case top." },
        "rjbCW": { "$ref": "common.schema.json#/$defs/cPerW", "description": "Junction to board." },
        "taOverrideC": { "$ref": "common.schema.json#/$defs/degC", "description": "Local air temperature for this part, if not the board ambient." },
        "notes": { "type": "string" },
        "loads": {
          "type": "array",
          "minItems": 1,
          "description": "Heat sources in this part. Pd of the part is the sum of its loads.",
          "items": { "$ref": "#/$defs/load" }
        }
      }
    },
    "load": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]+l[0-9]+$" },
        "label": { "type": "string", "description": "What this load is, e.g. 'buck1 > VDD_CORE'." },
        "rail": { "type": "string", "description": "Supply rail this load is fed from." },
        "method": { "$ref": "#/$defs/powerMethod", "description": "Blank = the default method of the part class." },
        "vinV": { "type": "number" },
        "iinA": { "type": "number", "minimum": 0 },
        "voutV": { "type": "number" },
        "ioutA": { "type": "number", "minimum": 0 },
        "efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Regulator efficiency at this load (0 to 1)." },
        "rOhm": { "type": "number", "minimum": 0, "description": "Resistance for I squared R (inductor DCR, sense resistor)." },
        "pdMeasuredW": { "$ref": "common.schema.json#/$defs/watt", "description": "Measured or datasheet Pd. Replaces the calculated value." }
      }
    },
    "bodyChoice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "boolean", "description": "Build this body in the thermal model." },
        "refDes": { "$ref": "common.schema.json#/$defs/refDes", "description": "Part this body belongs to. Its heat goes into this body." },
        "nameOverride": { "type": "string" },
        "override": { "$ref": "common.schema.json#/$defs/partialBox", "description": "Values that replace the imported box." },
        "manual": {
          "type": "object",
          "description": "A body the user added by hand (not in the STEP).",
          "required": ["name", "box"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "box": { "$ref": "common.schema.json#/$defs/box" },
            "side": { "$ref": "common.schema.json#/$defs/side" }
          }
        }
      }
    },
    "plateChip": {
      "type": "object",
      "required": ["refDes", "covered"],
      "additionalProperties": false,
      "properties": {
        "refDes": { "$ref": "common.schema.json#/$defs/refDes" },
        "covered": { "type": "boolean", "description": "The plate covers this chip, with a TIM between them." },
        "heightMode": { "$ref": "common.schema.json#/$defs/heightMode" },
        "timMode": { "$ref": "common.schema.json#/$defs/timMode" },
        "timTMm": { "$ref": "common.schema.json#/$defs/mmPos", "description": "Nominal TIM thickness (mm)." },
        "timK": { "$ref": "common.schema.json#/$defs/kWmK" }
      }
    },
    "plate": {
      "type": "object",
      "required": ["enabled", "material", "k", "densityKgM3", "thicknessMm", "clearanceXYMm", "clearanceZMm", "minPedestalMm", "heightMode"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "material": { "type": "string", "description": "Name used for the SolidWorks material." },
        "k": { "$ref": "common.schema.json#/$defs/kWmK" },
        "densityKgM3": { "type": "number", "exclusiveMinimum": 0 },
        "thicknessMm": { "$ref": "common.schema.json#/$defs/mmPos" },
        "clearanceXYMm": { "type": "number", "minimum": 0, "description": "Gap around tall parts the plate does not cover." },
        "clearanceZMm": { "type": "number", "minimum": 0, "description": "Parts closer than this to the plate face get a cut." },
        "minPedestalMm": { "type": "number", "minimum": 0, "description": "Below this the TIM fills the whole gap." },
        "heightMode": { "$ref": "common.schema.json#/$defs/plateHeightMode" },
        "heightManualMm": { "$ref": "common.schema.json#/$defs/mm", "description": "Plate face height from the PCB bottom face when Manual (mm). Negative for the bottom plate." },
        "chips": { "type": "array", "items": { "$ref": "#/$defs/plateChip" } }
      }
    },
    "solution": {
      "type": "object",
      "description": "Hand calculation of a common spreader (thermal solution tab).",
      "additionalProperties": false,
      "properties": {
        "plateLMm": { "$ref": "common.schema.json#/$defs/mmPos" },
        "plateWMm": { "$ref": "common.schema.json#/$defs/mmPos" },
        "plateTMm": { "$ref": "common.schema.json#/$defs/mmPos" },
        "plateK": { "$ref": "common.schema.json#/$defs/kWmK" },
        "hAir": { "type": "number", "exclusiveMinimum": 0, "description": "h from the plate to air, W/(m2 K)." },
        "faces": { "enum": [1, 2], "description": "Plate faces that lose heat to air." },
        "rPlateToAirOverrideCW": { "$ref": "common.schema.json#/$defs/cPerW" },
        "parts": {
          "type": "object",
          "description": "Per RefDes inputs of the stack: chip, TIM1, local spreader, TIM2, plate.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "underPlate": { "type": "boolean" },
              "tim1TMm": { "$ref": "common.schema.json#/$defs/mmPos" },
              "tim1K": { "$ref": "common.schema.json#/$defs/kWmK" },
              "localLMm": { "$ref": "common.schema.json#/$defs/mmPos" },
              "localWMm": { "$ref": "common.schema.json#/$defs/mmPos" },
              "localTMm": { "$ref": "common.schema.json#/$defs/mmPos" },
              "localK": { "$ref": "common.schema.json#/$defs/kWmK" },
              "tim2TMm": { "$ref": "common.schema.json#/$defs/mmPos" },
              "tim2K": { "$ref": "common.schema.json#/$defs/kWmK" },
              "plateShareOverrideMm2": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "flagLimit": {
      "type": "object",
      "required": ["marginBelowC", "densityAboveWcm2", "shareAbove"],
      "additionalProperties": false,
      "properties": {
        "marginBelowC": { "type": "number", "description": "Flag when Tj max - Tj est is below this (C)." },
        "densityAboveWcm2": { "type": "number", "description": "Flag when Pd per footprint area is above this (W/cm2)." },
        "shareAbove": { "$ref": "common.schema.json#/$defs/fraction", "description": "Flag when the part's share of board Pd is above this." }
      }
    },

    "forSolidWorks": {
      "type": "object",
      "description": "Worked out by the page on every save. The only numbers the macros read. Never edited by hand.",
      "required": ["computedAt", "computedBy", "ambientC", "pcb", "bodies", "heat"],
      "additionalProperties": false,
      "properties": {
        "computedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "computedBy": { "type": "string", "description": "'page 0.1.0', or 'workbook' when copied from an old workbook's cached values." },
        "inputsHash": { "type": "string", "description": "Hash of the PCB size and the bodies below. Build Board copies it into cad.json build, so the page can tell when the model is out of date." },
        "ambientC": { "$ref": "common.schema.json#/$defs/degC" },
        "pcb": {
          "type": "object",
          "required": ["l", "w", "h", "kxy", "kz"],
          "additionalProperties": false,
          "properties": {
            "l": { "$ref": "common.schema.json#/$defs/mmPos" },
            "w": { "$ref": "common.schema.json#/$defs/mmPos" },
            "h": { "$ref": "common.schema.json#/$defs/mmPos" },
            "kxy": { "$ref": "common.schema.json#/$defs/kWmK", "description": "PCB in-plane k." },
            "kz": { "$ref": "common.schema.json#/$defs/kWmK", "description": "PCB through-plane k." }
          }
        },
        "bodies": {
          "type": "array",
          "description": "Included bodies with the box to build (overrides applied).",
          "items": {
            "type": "object",
            "required": ["key", "name", "box"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "common.schema.json#/$defs/bodyKey" },
              "name": { "type": "string" },
              "refDes": { "$ref": "common.schema.json#/$defs/refDes" },
              "box": { "$ref": "common.schema.json#/$defs/box" },
              "rotDeg": { "type": "number", "description": "Turn in the board plane (degrees)." },
              "ownL": { "$ref": "common.schema.json#/$defs/mmPos" },
              "ownW": { "$ref": "common.schema.json#/$defs/mmPos" }
            }
          }
        },
        "heat": {
          "type": "object",
          "description": "Pd per RefDes (W), sum of its loads.",
          "additionalProperties": { "$ref": "common.schema.json#/$defs/watt" }
        },
        "chips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["refDes", "model"],
            "additionalProperties": false,
            "properties": {
              "refDes": { "$ref": "common.schema.json#/$defs/refDes" },
              "model": { "$ref": "common.schema.json#/$defs/chipModel" },
              "kz": { "$ref": "common.schema.json#/$defs/kWmK", "description": "k z = H / (Rjc x A), so the block has the datasheet Rjc." },
              "kxy": { "$ref": "common.schema.json#/$defs/kWmK" },
              "rjcCW": { "$ref": "common.schema.json#/$defs/cPerW" },
              "rjbCW": { "$ref": "common.schema.json#/$defs/cPerW" }
            }
          }
        },
        "plates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "$ref": "#/$defs/plateForSw" },
            "bottom": { "$ref": "#/$defs/plateForSw" }
          }
        },
        "flow": { "$ref": "#/$defs/flowForSw" },
        "openChecks": { "type": "array", "items": { "type": "string" }, "description": "Page checks not yet accepted on the page (tab 6). The macros refuse while there is one." }
      }
    },
    "flowContact": {
      "type": "object",
      "required": ["rKW", "areaMm2", "rSpecific"],
      "additionalProperties": false,
      "properties": {
        "rKW": { "type": "number", "exclusiveMinimum": 0, "description": "Integral resistance = rSpecific / area (K/W)." },
        "areaMm2": { "type": "number", "exclusiveMinimum": 0, "description": "Contact area it spreads over (mm2)." },
        "rSpecific": { "type": "number", "exclusiveMinimum": 0, "description": "K m2/W from simSetup.contacts." }
      }
    },
    "flowForSw": {
      "type": "object",
      "description": "What Run Flow Simulation needs beyond the rest of forSolidWorks (Flow plan F4, F5). Material paths are user materials in Flow's Engineering Database, named after their k in 10 % steps.",
      "additionalProperties": false,
      "properties": {
        "chips": {
          "type": "object",
          "description": "Per RefDes with heat: how the chip is modelled in Flow.",
          "additionalProperties": {
            "type": "object",
            "required": ["basis"],
            "additionalProperties": false,
            "properties": {
              "basis": { "$ref": "common.schema.json#/$defs/tjBasis" },
              "material": { "type": "string", "description": "Calibrated block: material path." },
              "layers": {
                "type": "object",
                "description": "Two-resistor: material path per layer body (PT_Box, PT_LayerCore, PT_LayerTop).",
                "required": ["bottom", "core", "top"],
                "additionalProperties": false,
                "properties": { "bottom": { "type": "string" }, "core": { "type": "string" }, "top": { "type": "string" } }
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "description": "Gravity, pressure, air velocity and domain margins for Run Flow (F6), from simSetup.flow.environment.",
          "required": ["gravity", "pressurePa", "velocity", "margins"],
          "additionalProperties": false,
          "properties": {
            "up": { "enum": ["+X", "-X", "+Y", "-Y", "+Z", "-Z"], "description": "Where the warm air goes (against gravity)." },
            "gravity": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "m/s2 in board axes." },
            "pressurePa": { "type": "number", "exclusiveMinimum": 0 },
            "velocity": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "m/s in board axes; all 0 for natural convection." },
            "margins": {
              "type": "object",
              "description": "Domain margin per side as a share of the largest board size.",
              "required": ["xMin", "xMax", "yMin", "yMax", "zMin", "zMax"],
              "additionalProperties": false,
              "properties": { "xMin": { "type": "number" }, "xMax": { "type": "number" }, "yMin": { "type": "number" }, "yMax": { "type": "number" }, "zMin": { "type": "number" }, "zMax": { "type": "number" } }
            }
          }
        },
        "pcb": { "type": "string", "description": "PCB material path (k xy, k z of the stack)." },
        "tims": { "type": "object", "description": "TIM material path per chip RefDes (TIM k with the chip to TIM contact folded in).", "additionalProperties": { "type": "string" } },
        "spreaders": {
          "type": "object", "additionalProperties": false,
          "properties": { "top": { "type": "string" }, "bottom": { "type": "string" } }
        },
        "surfaces": {
          "type": "object", "description": "Radiative surface path per component group (emissivity of tab 5 and 8).", "additionalProperties": false,
          "properties": { "spreader": { "type": "string" }, "pcb": { "type": "string" }, "parts": { "type": "string" } }
        },
        "contacts": {
          "type": "object", "description": "Contact resistances as Flow integral values (K/W over the contact area).", "additionalProperties": false,
          "properties": {
            "partToPcb": { "$ref": "#/$defs/flowContact" },
            "timToSpreader": { "$ref": "#/$defs/flowContact" }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" }, "description": "Where the Flow model is simpler than the page (shown on tab 8)." },
        "radiative": {
          "type": "array",
          "description": "Every user radiative surface the paths above name (Radiative Surfaces > User Defined > PCBThermal).",
          "items": {
            "type": "object",
            "required": ["name", "path", "emissivity"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "emissivity": { "type": "number", "minimum": 0, "maximum": 1 },
              "usedBy": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "materials": {
          "type": "array",
          "description": "Every user material the paths above name, to make once in the Engineering Database (Solids > User Defined > PCBThermal).",
          "items": {
            "type": "object",
            "required": ["name", "path", "kxy", "kz"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "kxy": { "$ref": "common.schema.json#/$defs/kWmK" },
              "kz": { "$ref": "common.schema.json#/$defs/kWmK" },
              "usedBy": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "plateForSw": {
      "type": "object",
      "required": ["faceZMm", "chips"],
      "additionalProperties": false,
      "properties": {
        "faceZMm": { "$ref": "common.schema.json#/$defs/mm", "description": "Height of the plate face that touches the TIMs, from the PCB bottom face." },
        "material": { "type": "string" },
        "k": { "$ref": "common.schema.json#/$defs/kWmK" },
        "densityKgM3": { "type": "number", "exclusiveMinimum": 0 },
        "thicknessMm": { "$ref": "common.schema.json#/$defs/mmPos" },
        "clearanceXYMm": { "type": "number", "minimum": 0 },
        "cuts": {
          "type": "array",
          "description": "Clearance cuts: included parts that are not covered and reach into the plate's clearance zone.",
          "items": {
            "type": "object",
            "required": ["key", "name", "xMin", "yMin", "l", "w", "edgeZMm"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "common.schema.json#/$defs/bodyKey" },
              "name": { "type": "string" },
              "xMin": { "$ref": "common.schema.json#/$defs/mm" },
              "yMin": { "$ref": "common.schema.json#/$defs/mm" },
              "l": { "$ref": "common.schema.json#/$defs/mmPos" },
              "w": { "$ref": "common.schema.json#/$defs/mmPos" },
              "edgeZMm": { "$ref": "common.schema.json#/$defs/mm", "description": "Top Z of the part for the top plate, bottom Z for the bottom plate." }
            }
          }
        },
        "chips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["refDes", "key", "timTMm", "pedestalMm", "timMode"],
            "additionalProperties": false,
            "properties": {
              "refDes": { "$ref": "common.schema.json#/$defs/refDes" },
              "key": { "$ref": "common.schema.json#/$defs/bodyKey" },
              "timTMm": { "type": "number", "minimum": 0 },
              "pedestalMm": { "type": "number", "minimum": 0 },
              "timMode": { "$ref": "common.schema.json#/$defs/timMode" },
              "timK": { "$ref": "common.schema.json#/$defs/kWmK" },
              "timRCW": { "$ref": "common.schema.json#/$defs/cPerW" }
            }
          }
        }
      }
    }
  }
}
